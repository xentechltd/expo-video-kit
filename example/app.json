{
  "expo": {
    "name": "expo-video-kit-example",
    "slug": "expo-video-kit-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-video-kit",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your videos to convert them."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "expo.modules.videokit.example",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow access to your videos to convert them."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "expo.modules.videokit.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
